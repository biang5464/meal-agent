# ── LLM ──────────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-...
# Optional overrides (defaults are already set in config.py):
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# ── Database (MySQL) ──────────────────────────────────────────────────────────
# Option A: full URL (takes priority over component variables below)
DATABASE_URL=
# Option B: Railway MySQL plugin URL (second priority)
MYSQL_URL=
# Option C: individual component variables (used when A and B are absent)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=meal_agent

# ── Redis ─────────────────────────────────────────────────────────────────────
# Option A: full URL, e.g. redis://default:password@host:6379/0 or rediss://...
REDIS_URL=
# Option B: component variables (used when REDIS_URL is absent)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── Storage paths ─────────────────────────────────────────────────────────────
# Runtime writable data — on Railway, mount a Volume at /app/runtime-data
# and set these to /app/runtime-data/... to persist across deploys.
# Do NOT mount the Volume at /app/data — that would shadow the committed seed docs.
CHROMA_PERSIST_DIR=./data/chroma
SQLITE_DB_PATH=./data/users.db
DEAD_LETTER_DB_PATH=./data/dead_letter.db
# HuggingFace model cache (embedding model)
HF_HOME=./data/huggingface

# Read-only seed knowledge (committed to repo, not stored on Volume)
NUTRITION_DIR=./data/nutrition
FOOD_SAFETY_DIR=./data/food_safety

# ── App environment ───────────────────────────────────────────────────────────
# "development" (default): CORS allows localhost, no ALLOWED_ORIGINS required
# "production": ALLOWED_ORIGINS must be set and non-wildcard
APP_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (trailing slash stripped automatically)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production example (set in Railway/Vercel dashboard, not here):
# ALLOWED_ORIGINS=https://your-project.vercel.app

# ── Deployment ────────────────────────────────────────────────────────────────
# Scheduler: set to "false" on Web replicas if running a separate Worker instance
RUN_SCHEDULER=true

# ── Price API (optional) ──────────────────────────────────────────────────────
PRICE_API_KEY=
PRICE_API_BASE_URL=

# ── Frontend ──────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* variables are exposed to the browser — never put secrets here.
# Configure in Vercel project settings, not in .env:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
